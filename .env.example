# 数字生命运行配置示例
# 说明：仓库只保留示例，不提交真实 key/token。真实值请放本地 `.env`，或通过 `DIGITAL_LIFE_ENV_FILE` 指向其他文件。

# 数字生命运行档位。用于区分本地试验、常驻运行、受限运行等。
DIGITAL_LIFE_RUNTIME_PROFILE=resident

# 模型提供方标识。local 表示不调用外部模型，只保留确定性生命回应。
# 若要启用模型表达层，可设置为 openai-compatible、openai 或 wyzai，并填写 base URL 与 key。
DIGITAL_LIFE_MODEL_PROVIDER=local

# 模型名称。启用模型表达层时会作为 chat completions 的 model 字段。
DIGITAL_LIFE_MODEL_NAME=digital-life-core

# 模型基址。OpenAI 兼容接口一般形如 https://example.com/v1，不需要写 /chat/completions。
DIGITAL_LIFE_MODEL_BASE_URL=

# 模型密钥。不要填写真实密钥到示例文件；在服务商控制台或你自己的模型网关后台获取。
DIGITAL_LIFE_MODEL_API_KEY=

# 生成温度。为空表示由内核默认值处理。
DIGITAL_LIFE_MODEL_TEMPERATURE=

# 最大输出 token 数。为空表示由内核默认值处理。
DIGITAL_LIFE_MODEL_MAX_OUTPUT_TOKENS=

# 请求超时秒数。为空表示由内核默认值处理。
DIGITAL_LIFE_MODEL_TIMEOUT_SECONDS=

# 生命体对外交互的默认语言。
DIGITAL_LIFE_RESPONSE_LANGUAGE=zh-CN

# 对话风格标识。用于关系性表达层记录。
DIGITAL_LIFE_DIALOGUE_STYLE=relationship

# 是否默认严格模式。true/false。
DIGITAL_LIFE_STRICT_DEFAULT=false

# 是否开启网页梦境学习默认值。true/false。
# 开启后，终端退出后的梦境整合可以只读浏览网页，把网页内容沉淀成醒来话题线索。
DIGITAL_LIFE_WEB_DREAM_LEARNING_ENABLED=false

# 网页梦境学习的默认 URL 池。多个地址用英文逗号分隔。
# 建议放 GitHub、Hugging Face、Nature、Science、PubMed、Cell、PNAS、arXiv、AI Hot、Linux.do、Bilibili、X/Twitter、今日头条等。
# 这些地址只作为默认网页池，运行时仍可通过 /dream-web on|off|status 手动控制。
DIGITAL_LIFE_WEB_DREAM_URLS=

# 每个网页种子允许的只读跳转上限。为空表示采用代码默认值。
DIGITAL_LIFE_WEB_DREAM_MAX_HOPS_PER_SEED=

# 每页只读抓取的最长秒数。为空表示采用代码默认值。
DIGITAL_LIFE_WEB_DREAM_MAX_SECONDS_PER_PAGE=

# 如果本地不想把真实 `.env` 放在仓库根目录，可在 shell 里把这里指向其他文件路径。
# DIGITAL_LIFE_ENV_FILE=/absolute/path/to/your/local.env
